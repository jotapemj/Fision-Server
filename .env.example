# Fision server - Docker Compose settings. Copy to .env and adjust.
# Every server variable is listed in docs/REFERENCE.md (Configuration).

# ---- Image ----
# cu129: RTX 20xx and newer. cu126: Pascal (GTX 10xx) and older. cpu: no GPU
# (use compose.cpu.yaml as well).
#FISION_IMAGE_TAG=cu129
#FISION_TORCH_INDEX=cu129

# ---- Network ----
# Address and port published on the host. Docker bypasses host firewalls
# such as UFW, so the default is loopback only. For Tailscale, set the
# address printed by `tailscale ip -4`. Never 0.0.0.0 on a public host.
#FISION_BIND=127.0.0.1
#FISION_PUBLISH_PORT=8000
# Behind a reverse proxy (HTTPS for the web app), the address the proxy
# connects from, so logs, the login limit and the admin panel see the real
# client. With `tailscale serve` on the same host: the FISION_BIND address.
# Only that address: anyone it trusts can claim any client IP.
#FORWARDED_ALLOW_IPS=100.x.y.z

# ---- Storage on the host ----
# Create the folders before the first start, owned by FISION_UID.
#FISION_DATA_PATH=./data
#FISION_LIBRARY_PATH=./library
#FISION_MODELS_PATH=./models
# User the image runs as (match the owner of the folders above; build-time).
#FISION_UID=1000
#FISION_GID=1000

# ---- Server ----
# Time zone of the log timestamps (default UTC).
#TZ=Europe/Madrid
#FISION_WHISPER_MODEL=large-v2
# Batched Whisper, >= 8 GB VRAM
#FISION_WHISPER_BATCH_SIZE=16
#FISION_MAX_UPLOAD_MB=200
#FISION_MAX_JOBS_PER_USER=3

# ---- Pascal (GTX 10xx) and older ----
#FISION_WHISPER_COMPUTE=int8
#FISION_SEP_AUTOCAST=0
